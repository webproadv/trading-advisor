# --- Accesso all'app (scegli valori lunghi e casuali) ---
APP_PASSWORD=
SESSION_SECRET=            # almeno 32 caratteri casuali
CRON_SECRET=               # almeno 24 caratteri casuali (lo stesso va in supabase/cron.sql)
APP_URL=https://tuo-progetto.vercel.app

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=  # SEGRETA: solo lato server, mai nel browser

# --- eToro: chiavi del conto DEMO ---
ETORO_API_KEY=
ETORO_USER_KEY=

# --- Claude (analisi con ricerca web) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=   # stringa casuale, 16-64 caratteri A-Z a-z 0-9 _ -
